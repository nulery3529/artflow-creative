{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "alias": [
    "artflowcreative.com",
    "www.artflowcreative.com"
  ],
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/auth/(.*)", "dest": "/api/better-auth?__path=$1" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
