{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "alias": [
    "artflowcreative.com",
    "www.artflowcreative.com"
  ],
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 30
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/auth/(.*)", "dest": "/api/better-auth?__path=$1" },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
